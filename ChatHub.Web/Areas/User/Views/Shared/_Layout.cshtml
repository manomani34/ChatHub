<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - ChatHub
    </title>


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/chat.css"
          asp-append-version="true" />

</head>


<body>

    <header class="ch-header">

        <div class="ch-brand">
            ChatHub
        </div>


        <nav class="ch-header-actions">

            <!-- Theme -->
            <button type="button"
                    id="themeToggle"
                    class="header-action-button theme-toggle"
                    title="تغییر حالت نمایش">

                <span class="header-action-icon">
                    🌙
                </span>

            </button>


            <!-- Home -->
            <a asp-area="User"
               asp-controller="Home"
               asp-action="Index"
               class="header-action-button home-action">

                <span class="header-action-icon">
                    ⌂
                </span>

                <span class="header-action-text">
                    خانه
                </span>

            </a>


            <!-- Logout -->
            <form asp-area="Auth"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="logout-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="header-action-button logout-action"
                        title="خروج">

                    <span class="header-action-icon">
                        ↪
                    </span>

                    <span class="header-action-text">
                        خروج
                    </span>

                </button>

            </form>

        </nav>

    </header>


    <main class="ch-main">

        @RenderBody()

    </main>


    <!-- Theme -->
    <script src="~/js/theme.js"
            asp-append-version="true">
    </script>


    <!-- Optional page scripts -->
    @await RenderSectionAsync(
        "Scripts",
        required: false)


    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>


    <script src="~/js/signalr-test.js"
            asp-append-version="true">
    </script>


    <script src="~/js/chat.js"
            asp-append-version="true">
    </script>

</body>

</html>
